# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional: extra allowed frontend origins, comma-separated (e.g. a custom domain). Exact match, https in production.
CLIENT_URLS=

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/foodrush

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Cloudinary (optional — leave blank to use local disk storage in dev)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional test-mode online payment — leave blank to only allow Cash on Delivery)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=

# One-time super-admin provisioning (scripts/bootstrap-super-admin.js) — set only when running it, never commit real values.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=
