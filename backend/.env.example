# Server
PORT=5000
NODE_ENV=development
CLIENT_URL=http://localhost:5173
# Optional: extra allowed frontend origins, comma-separated (e.g. a custom domain). Exact match, https in production.
CLIENT_URLS=

# Database
MONGODB_URI=mongodb://127.0.0.1:27017/foodrush

# Auth
JWT_SECRET=replace_with_a_long_random_string
JWT_EXPIRES_IN=7d

# Uploads
UPLOAD_DIR=uploads
MAX_UPLOAD_SIZE_MB=5

# Cloudinary — permanent image storage. Set ALL THREE (a partial set is rejected at boot). Required for any
# real deployment: Render's disk is wiped on every restart. Leave blank in local dev to use local disk.
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Razorpay (optional online payment — leave blank to only allow Cash on Delivery). Use TEST-mode
# keys (rzp_test_...) until the flow is verified end to end; only switch to live keys after that.
# RAZORPAY_WEBHOOK_SECRET is the "Secret" you set when adding a webhook in the Razorpay dashboard
# (Settings > Webhooks), pointed at https://<your-backend>/api/payments/webhook — it confirms
# payments/refunds even if the customer's browser never calls back (e.g. they closed the tab).
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=

# One-time super-admin provisioning (scripts/bootstrap-super-admin.js) — set only when running it, never commit real values.
SUPER_ADMIN_EMAIL=
SUPER_ADMIN_PASSWORD=

# Email (password reset). Provider is chosen here; switching needs no code change.
#   none    = disabled (default)      log = print to console (development only)
#   smtp    = any SMTP server (needs SMTP_HOST, EMAIL_FROM; SMTP_USER/SMTP_PASS if it requires login)
#   resend  = Resend API (needs RESEND_API_KEY, EMAIL_FROM)
EMAIL_PROVIDER=none
EMAIL_FROM=FoodRush <no-reply@yourdomain.com>
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
RESEND_API_KEY=
# Public URL of the web app, used in emailed links. Defaults to the first CLIENT_URL.
APP_URL=

# Location (address search + reverse geocoding + the live-tracking map). SERVER-SIDE key only —
# it is never sent to the browser. In Google Cloud enable "Places API (New)", "Geocoding API" and
# "Maps Static API", restrict this key to just those, and set a budget alert / daily quota.
# Optional: without it, GPS and "popular cities" still work, and delivery tracking still works —
# it just shows "map unavailable" instead of a map image.
GOOGLE_MAPS_API_KEY=
# Two-letter country code that address suggestions are limited to.
GEO_COUNTRY=in

# Real-time delivery tracking (M8). Minimum milliseconds between accepted rider
# location updates, enforced server-side regardless of what the client sends.
# Optional — defaults to 5000 (5s).
LOCATION_UPDATE_MIN_INTERVAL_MS=5000

# Delivery-completion OTP (M9). Both optional.
# How long a generated OTP is valid for. Default 30.
DELIVERY_OTP_EXPIRY_MINUTES=30
# Wrong guesses allowed before this OTP is permanently locked (the rider then needs
# the restaurant/admin's existing manual "mark delivered" fallback). Default 5.
DELIVERY_OTP_MAX_ATTEMPTS=5

# Delivery-partner earnings (M10). All optional — sensible defaults below.
#
# IMPORTANT, CHANGED IN M17: these four are now SEED VALUES, not runtime settings.
# They are read exactly once, when the platform settings row is first created, and
# ignored on every boot after that. The live values are edited by a SUPER_ADMIN at
# /admin/settings (or via PATCH /api/admin/settings) and stored in the database, so
# changing a rate no longer needs a redeploy — and editing one of these AFTER first
# boot will appear to do nothing, which is the intended behaviour, not a bug.
# The tax rate has no env var at all and has always lived in code; it is now
# editable on the same screen.
#
# Flat amount every completed delivery earns, before distance. Default 20 (INR).
DELIVERY_BASE_EARNING=20
# Added per km of Order.deliveryDistanceKm (0 when that order has no distance on
# file). Default 6 (INR/km).
DELIVERY_PER_KM_RATE=6
# Floor applied after base+distance+incentive. Default 20.
DELIVERY_MIN_EARNING=20
# Optional ceiling. Left unset = no cap.
DELIVERY_MAX_EARNING=

# Notifications (M12). Uses the SAME email provider config above (EMAIL_PROVIDER /
# SMTP_* / RESEND_API_KEY / EMAIL_FROM) — nothing new to configure there. Optional.
# How many times a single notification's email may be (re)attempted in total —
# a manual retry (notification.service.js#retryFailedEmail) is refused once this
# is reached. No automatic retry scheduler exists; see DEPLOYMENT.md. Default 3.
NOTIFICATION_EMAIL_MAX_ATTEMPTS=3
